# Copy to .env and fill in. NEVER commit .env.

# --- Model access: DeepSeek models via OpenRouter (OpenAI-compatible) ---
# We reach the DeepSeek models through OpenRouter, which speaks the OpenAI API.
# Put your OpenRouter key here (sk-or-...). Base URL must end in /v1.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- models under test (comma-separated; two DeepSeek tiers, OpenRouter slugs) ---
# Namespaced slugs. Avoid the ~...-latest aliases (floating). The harness logs the
# exact model ID the API returns per trial for reproducibility.
MODELS=deepseek/deepseek-v4.1-flash,deepseek/deepseek-v4-pro-0813

# --- service endpoints ---
BACKEND_URL=http://127.0.0.1:8000
COLLECTOR_URL=http://127.0.0.1:9100/collect
COLLECTOR_PORT=9100

# --- experiment settings ---
TRIALS_PER_CASE=20
TEMPERATURE=0.0
MAX_STEPS=8
