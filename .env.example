# Copy to .env and fill in. NEVER commit .env.

# --- DeepSeek API (OpenAI-compatible) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- models under test (comma-separated; two DeepSeek tiers) ---
# These are family aliases, not dated snapshots, so the harness records the exact
# model ID the API returns on every trial for reproducibility.
MODELS=deepseek-flash,deepseek-v4-pro

# --- service endpoints ---
BACKEND_URL=http://127.0.0.1:8000
COLLECTOR_URL=http://127.0.0.1:9100/collect
COLLECTOR_PORT=9100

# --- experiment settings ---
TRIALS_PER_CASE=20
TEMPERATURE=0.0
MAX_STEPS=8
